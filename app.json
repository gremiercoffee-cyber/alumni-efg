{
  "expo": {
    "name": "EFG Alumni",
    "slug": "efg-alumni",
    "scheme": "efgalumni",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "edu.aish.efgalumni",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#061437"
      }
    },
    "plugins": [
      "expo-notifications",
      "expo-asset",
      [
        "expo-av",
        {
          "microphonePermission": "EFG Alumni uses the microphone so you can dictate what to file."
        }
      ],
      "./plugins/withAbiFilters"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6bb5fbcc-8752-4266-8155-d09efae25dc1"
      }
    },
    "owner": "gremiercoffee",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6bb5fbcc-8752-4266-8155-d09efae25dc1",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "fallbackToCacheTimeout": 10000
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#061437"
    }
  }
}
